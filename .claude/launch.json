{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@slap/web",
        "dev:mock",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "screen-lab",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "screen-lab"
      ],
      "port": 4173
    }
  ]
}
