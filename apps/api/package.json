{
  "name": "@slap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --env-file-if-exists=../../../.env.local --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../../.env.local --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../../.env.local --env-file-if-exists=../../.env src/scripts/seed.ts",
    "test": "node --test --env-file-if-exists=../../.env.local --env-file-if-exists=../../../.env.local \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@napi-rs/canvas": "^0.1.80",
    "@neondatabase/serverless": "^1.0.1",
    "@slap/contracts": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "@hono/node-server": "^1.19.0",
    "jose": "^6.0.11",
    "qrcode": "^1.5.4",
    "ts-fsrs": "^5.2.0",
    "ws": "^8.18.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0"
  }
}