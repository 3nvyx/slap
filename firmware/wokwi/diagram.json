{
  "version": 1,
  "author": "slap",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ssd1306", "id": "oled", "top": -120, "left": 280, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led1", "top": 60, "left": 320, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 110, "left": 300, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 170, "left": 300, "attrs": { "color": "green", "label": "BOOT / start-stop" } }
