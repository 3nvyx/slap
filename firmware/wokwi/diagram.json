    [ "oled:SCL", "esp:9", "blue", [] ],
    [ "oled:SDA", "esp:8", "green", [] ],

    [ "esp:2", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],

    [ "btn1:1.l", "esp:0", "violet", [] ],
    [ "btn1:2.l", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
